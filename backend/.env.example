# Copy this file to backend/.env and fill in your own values.
PORT=5000
NODE_ENV=development

# Local MongoDB (start mongod first)
MONGO_URI=mongodb://localhost:27017/tourguide

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Google Maps: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
GOOGLE_MAPS_MAP_ID=YOUR_MAP_ID

# Gemini (free key): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
